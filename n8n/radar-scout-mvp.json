    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpRequest",
        "sendBody": true,
        "body": "={\n  \"model\": \"openrouter/auto\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a content analyst. Return only valid JSON.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Analyze this content: {{ $json.content }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "openrouter-analyze-signal",
      "name": "OpenRouter -- Analyze Signal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [660, 0],
      "credentials": null
    },
    {
      "parameters": {
        "jsCode": "// Parse the AI response and prepare for Notion\nconst data = $input.first().json;\nconst choices = data.choices || [];\nconst message = choices[0]?.message?.content || '{}';\n\nlet parsed;\ntry {\n  parsed = JSON.parse(message);\n} catch (e) {\n  parsed = {\n    signal_type: 'Unknown',\n    mechanic: '',\n    why_it_works: '',\n    relevance: 'Low',\n    adaptation_hint: '',\n    _raw: message\n  };\n}\n\nreturn [{\n  json: {\n    source: $json.source,\n    url: $json.url,\n    ...parsed\n  }\n}];\n"
      },
      "id": "parse-ai-analysis",
      "name": "Parse AI Analysis",
      "type": "n8n-nodes-base.code",
